# ============================================================
# SPEEDSCALE GARAGE — BACKEND ENVIRONMENT CONFIGURATION (VERCEL)
# ============================================================

# Runtime Environment ('development' | 'production' | 'test')
NODE_ENV=production

# Server Port & Host (Default 4000 for local dev)
PORT=4000
HOST=0.0.0.0

# Supabase PostgreSQL Session Pooler (Port 5432 or 6543)
DATABASE_URL=postgresql://postgres.xxx:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?pgbouncer=true

# JWT Token Signing Secret (Generate a strong 32+ char random string)
JWT_SECRET=speedscale_garage_jwt_production_secret_key_2026

# Frontend Origin URL for CORS
FRONTEND_URL=https://speedscalegarage.vercel.app

# Public Backend URL
BASE_URL=https://speedscalegarage-backend.vercel.app

# Optional: Master Admin Seed Override (Used by clean-slate or init-db)
ADMIN_EMAIL=admin@speedscalegarage.com
ADMIN_PASSWORD=speedscale123

# Optional: Transactional Email Dispatch (SMTP / Gmail / SendGrid)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=orders@speedscalegarage.com
SMTP_PASS=your_app_password_here
SMTP_FROM="SpeedScale Garage" <orders@speedscalegarage.com>
ADMIN_NOTIFICATION_EMAIL=admin@speedscalegarage.com

# Optional: Meta Facebook Conversions API (CAPI)
FB_PIXEL_ID=
FB_ACCESS_TOKEN=
